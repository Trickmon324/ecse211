# 9. ENTRANCE & DROP-OFF GEOMETRY + SAFE APPROACH / PATH PLANNING
# ==============================================================================
def parse_coord_pair(prompt_text):
    while True:
        raw = input(prompt_text).strip().replace("(", "").replace(")", "").replace(",", " ")
        parts = raw.split()
        if len(parts) == 2:
            try:
                gx, gy = int(parts[0]), int(parts[1])
                if MAP_X_MIN <= gx <= MAP_X_MAX and MAP_Y_MIN <= gy <= MAP_Y_MAX:
                    return (gx, gy)
                print(f"Coordinates out of arena bounds [{MAP_X_MIN},{MAP_X_MAX}] x [{MAP_Y_MIN},{MAP_Y_MAX}].")
                continue
            except ValueError:
                pass
        print("Invalid input. Enter two integers like: 1 3")


def vec_to_heading(ux, uy):
    if ux == 0 and uy == 1:
        return 0.0
    if ux == 1 and uy == 0:
        return 90.0
    if ux == 0 and uy == -1:
        return 180.0
    return 270.0


def compute_gate_plan(s1, s2):
    """
    Per PDF spec: when facing the street, s1 is on the LEFT and s2 is on the RIGHT.
    Therefore entry_vec = (-(s2_y - s1_y), (s2_x - s1_x)).
    """
    x1, y1 = s1
    x2, y2 = s2
    dx, dy = x2 - x1, y2 - y1
    if abs(dx) + abs(dy) != 1:
        raise ValueError(f"Invalid street entrance s1={s1}, s2={s2}: must be 1 grid unit apart.")

    entry_ux, entry_uy = -dy, dx
    entry_heading = vec_to_heading(entry_ux, entry_uy)
    exit_heading = (entry_heading + 180.0) % 360.0

    mx = (x1 + x2) / 2.0
    my = (y1 + y2) / 2.0

    if abs(entry_ux) == 1:
        gate_axis = "vertical"
        x_gate = float(x1)
        gate_line_cm = x_gate * TILE
        gate_center_perp_cm = my * TILE

        # Pick safe staging x outside the gate wall
        if entry_ux > 0 and x_gate == 1.0:
            x_stage = 0.0
        elif entry_ux > 0 and x_gate == 0.0:
            x_stage = -0.5
        else:
            x_stage = x_gate - 0.5 * entry_ux

        waypoints = []
        if entry_ux < 0 and x_gate > 0:
            # Gate faces -X (toward origin): step to y=-0.5 to get past street first, then x_stage
            waypoints.append((0.0, -0.5 * TILE, 180.0))
            waypoints.append((x_stage * TILE, -0.5 * TILE, 90.0))
            y_dir = 0.0 if my >= -0.5 else 180.0
            waypoints.append((x_stage * TILE, my * TILE, y_dir))
        else:
            if abs(x_stage - 0.0) > 1e-6:
                waypoints.append((x_stage * TILE, 0.0, 90.0 if x_stage > 0 else 270.0))
            y_dir = 0.0 if my >= 0.0 else 180.0
            waypoints.append((x_stage * TILE, my * TILE, y_dir))

        stage_pt = (x_stage * TILE, my * TILE)
        stage_tile = coord_to_tile((x_gate - 0.5 * entry_ux) * TILE, my * TILE)
        first_tile_center = ((x_gate + 0.5 * entry_ux) * TILE, my * TILE)
    else:
        gate_axis = "horizontal"
        y_gate = float(y1)
        gate_line_cm = y_gate * TILE
        gate_center_perp_cm = mx * TILE

        if entry_uy > 0 and y_gate == 1.0:
            y_stage = 0.0
        elif entry_uy > 0 and y_gate == 0.0:
            y_stage = -0.5
        else:
            y_stage = y_gate - 0.5 * entry_uy

        waypoints = []
        if entry_uy < 0 and y_gate > 0:
            waypoints.append((-0.5 * TILE, 0.0, 270.0))
            waypoints.append((-0.5 * TILE, y_stage * TILE, 0.0))
            x_dir = 90.0 if mx >= -0.5 else 270.0
            waypoints.append((mx * TILE, y_stage * TILE, x_dir))
        else:
            if abs(y_stage - 0.0) > 1e-6:
                waypoints.append((0.0, y_stage * TILE, 0.0 if y_stage > 0 else 180.0))
            x_dir = 90.0 if mx >= 0.0 else 270.0
            waypoints.append((mx * TILE, y_stage * TILE, x_dir))

        stage_pt = (mx * TILE, y_stage * TILE)
        stage_tile = coord_to_tile(mx * TILE, (y_gate - 0.5 * entry_uy) * TILE)
        first_tile_center = (mx * TILE, (y_gate + 0.5 * entry_uy) * TILE)

    first_tile = coord_to_tile(*first_tile_center)
    protected_open_tiles.add(clamp_tile_in_bounds(*stage_tile))
    protected_open_tiles.add((0, 0))
    protected_open_tiles.add((-1, -1))
    protected_open_tiles.add((-1, 0))
    protected_open_tiles.add((0, -1))

    return {
        "gate_axis": gate_axis,
        "s1": s1,
        "s2": s2,
        "waypoints_to_stage": waypoints,
        "stage_pt": stage_pt,
        "stage_tile": clamp_tile_in_bounds(*stage_tile),
        "entry_heading": entry_heading,
        "exit_heading": exit_heading,
        "entry_vec": (entry_ux, entry_uy),
        "gate_line_cm": gate_line_cm,
        "gate_center_perp_cm": gate_center_perp_cm,
        "first_tile_center": first_tile_center,
        "first_tile": first_tile,
    }


def compute_dropoff_plan(d1, d2):
    """
    Determine inside drop-off tile and the heading that parks the robot's BACK
    at the (d1, d2) bucket edge.
    """
    x1, y1 = d1
    x2, y2 = d2
    if abs(x2 - x1) + abs(y2 - y1) != 1:
        raise ValueError(f"Invalid drop-off d1={d1}, d2={d2}: must be 1 grid unit apart.")

    if y1 == y2 == MAP_Y_MIN:
        # Bottom edge -> bucket is -Y -> face +Y (0 deg) so BACK faces bucket
        return (min(x1, x2), MAP_Y_MIN), 0.0
    if y1 == y2 == MAP_Y_MAX:
        # Top edge -> bucket is +Y -> face -Y (180 deg)
        return (min(x1, x2), MAP_Y_MAX - 1), 180.0
    if x1 == x2 == MAP_X_MIN:
        # Left edge -> bucket is -X -> face +X (90 deg)
        return (MAP_X_MIN, min(y1, y2)), 90.0
    if x1 == x2 == MAP_X_MAX:
        # Right edge -> bucket is +X -> face -X (270 deg)
        return (MAP_X_MAX - 1, min(y1, y2)), 270.0

    raise ValueError(f"Drop-off d1={d1}, d2={d2} must lie on outer edge of map [-1,8] x [-1,4].")


def navigate_origin_to_entrance(plan):
    print("[NAV] Moving from (0, 0) to street entrance safely...")
    for wx, wy, hdg in plan["waypoints_to_stage"]:
        cur_x, cur_y, _, _ = get_pose()
        if math.hypot(wx - cur_x, wy - cur_y) < 1.0:
            continue
        ok, bumped = drive_to_point_cardinal(wx, wy, hdg, use_line_squaring=True, initial_blind_cm=4.0)
        if bumped:
            print("[WARN] Unexpected bump during approach; backing up.")
            back_up(BUMP_BACKUP_CM, hdg)

    ftx, fty = plan["first_tile_center"]
    ok, bumped = drive_to_point_cardinal(
        ftx, fty, plan["entry_heading"], use_line_squaring=True, initial_blind_cm=4.0
    )
    if bumped:
        print("[WARN] Bumper triggered entering gate; backing up slightly.")
        back_up(BUMP_BACKUP_CM, plan["entry_heading"])
    print(f"[NAV] Centered inside street entry tile {plan['first_tile']}.")


def navigate_entrance_to_origin(plan):
    print("[NAV] Returning from street exit to (0, 0)...")
    sx, sy = plan["stage_pt"]
    exit_h = plan["exit_heading"]

    drive_to_point_cardinal(sx, sy, exit_h, use_line_squaring=True, initial_blind_cm=BLIND_AFTER_LINE_CM)

    rev_points = [(0.0, 0.0)]
    if len(plan["waypoints_to_stage"]) > 1:
        rev_points = [(wx, wy) for (wx, wy, _) in reversed(plan["waypoints_to_stage"][:-1])] + [(0.0, 0.0)]

    for px, py in rev_points:
        cur_x, cur_y, _, _ = get_pose()
        dx, dy = px - cur_x, py - cur_y
        if math.hypot(dx, dy) < 1.0:
            continue
        hdg = (90.0 if dx > 0 else 270.0) if abs(dx) >= abs(dy) else (0.0 if dy > 0 else 180.0)
        drive_to_point_cardinal(px, py, hdg, use_line_squaring=True, initial_blind_cm=4.0)

    turn_to_heading(START_HEADING_DEG)
    print("[NAV] Returned cleanly to origin (0, 0).")


