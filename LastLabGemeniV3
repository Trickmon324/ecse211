# 10. FULL-SQUARE WALL-BOX MAPPING & PHASE 1 ENGINE
# ==============================================================================
def enter_street_tile(tx, ty):
    """Mark tile as traversed street; removes any prior wall assumption on it."""
    if not tile_in_bounds(tx, ty):
        return
    if (tx, ty) in wall_boxes:
        del wall_boxes[(tx, ty)]
    if not street_tiles or street_tiles[-1] != (tx, ty):
        street_tiles.append((tx, ty))


def mark_wall_box(tx, ty, source):
    """Record a full 1x1 grid square wall box with its 4 corner coordinates."""
    if not tile_in_bounds(tx, ty):
        return None
    if (tx, ty) in street_tiles or (tx, ty) in protected_open_tiles:
        return None
    corners = tile_corners(tx, ty)
    wall_boxes[(tx, ty)] = {"corners": corners, "source": source}
    return corners


def get_adjacent_tiles_for_heading(tx, ty, heading_deg):
    ux, uy = heading_unit_vec(heading_deg)
    rx, ry = right_unit_vec(heading_deg)
    side_mult = 1.0 if SIDE_SENSOR_ORIENTATION == "right" else -1.0

    fx, fy = int(round(ux)), int(round(uy))
    sx, sy = int(round(rx * side_mult)), int(round(ry * side_mult))

    front_tile = (tx + fx, ty + fy)
    side_tile = (tx + sx, ty + sy)
    opp_tile = (tx - sx, ty - sy)
    return front_tile, side_tile, opp_tile


def clear_square_and_mark_walls(cleared_tile, heading_deg, saw_wall_in_tile):
    """
    Once the robot completely clears a street square (tx, ty), if the ultrasonic
    sensor detected the corridor wall, mark the full 1x1 wall squares on BOTH
    the left and right of that street tile (ignoring already-visited street tiles).
    """
    tx, ty = cleared_tile
    _, side_tile, opp_tile = get_adjacent_tiles_for_heading(tx, ty, heading_deg)
    if saw_wall_in_tile:
        c_side = mark_wall_box(side_tile[0], side_tile[1], "cleared_side")
        c_opp = mark_wall_box(opp_tile[0], opp_tile[1], "cleared_opp")
        print(f"[BOX] Cleared tile {cleared_tile} -> side wall={c_side}, opp wall={c_opp}")


def near_board_edge(cur_x, cur_y, heading_deg):
    """
    True if robot is in the middle of an outer boundary square heading toward
    the outer edge of the 9x5 board (prevents ever falling off the table).
    """
    ux, uy = heading_unit_vec(heading_deg)
    if ux > 0.5 and cur_x >= (MAP_X_MAX * TILE) - EDGE_STOP_MARGIN_CM:
        return True
    if ux < -0.5 and cur_x <= (MAP_X_MIN * TILE) + EDGE_STOP_MARGIN_CM:
        return True
    if uy > 0.5 and cur_y >= (MAP_Y_MAX * TILE) - EDGE_STOP_MARGIN_CM:
        return True
    if uy < -0.5 and cur_y <= (MAP_Y_MIN * TILE) + EDGE_STOP_MARGIN_CM:
        return True
    return False


def crossed_exit_gate(plan, cur_x, cur_y, cur_heading):
    if abs(wrap180(cur_heading - plan["exit_heading"])) > 20.0:
        return False

    ex_ux, ex_uy = heading_unit_vec(plan["exit_heading"])
    gate_line = plan["gate_line_cm"]
    gate_perp = plan["gate_center_perp_cm"]

    if plan["gate_axis"] == "vertical":
        perp_ok = abs(cur_y - gate_perp) <= (TILE * 0.55)
        dist_outside = (cur_x - gate_line) * ex_ux
    else:
        perp_ok = abs(cur_x - gate_perp) <= (TILE * 0.55)
        dist_outside = (cur_y - gate_line) * ex_uy

    return perp_ok and dist_outside >= 2.0


def map_street(plan, pass_num=1, reset_map=True):
    if reset_map:
        wall_boxes.clear()
        street_tiles.clear()

    target_heading = plan["entry_heading"]
    side_mult = 1.0 if SIDE_SENSOR_ORIENTATION == "right" else -1.0

    _, _, _, start_trav = get_pose()
    last_line_trav = start_trav
    last_bump_turn_trav = start_trav
    blind_cm = BLIND_AFTER_TURN_CM

    heading_sum = 0.0
    heading_cnt = 0

    bumped_once = False
    just_turned_from_wall = False
    last_turn_dir = 0.0
    left_entry_tile = False

    cur_tile = plan["first_tile"]
    enter_street_tile(*cur_tile)
    saw_wall_in_cur_tile = False
    turned_in_cur_tile = False

    last_prog_t = time.monotonic()
    last_trav = start_trav
    boost = 0.0
    last_dbg = last_prog_t

    sample_fresh_side_us()
    print(f"[MAP Pass {pass_num}] Starting mapping... | {format_sensor_line()}")

    while not shutdown.is_set():
        cur_x, cur_y, cur_theta, cur_trav = get_pose()
        tx, ty = coord_to_tile(cur_x, cur_y)

        # ------------------------------------------------------------------
        # 1. Board Edge Safety & Exit Gate Checks
        # ------------------------------------------------------------------
        if near_board_edge(cur_x, cur_y, target_heading):
            stop_motors()
            print(f"[MAP Pass {pass_num}] Reached board edge at ({cur_x:.1f}, {cur_y:.1f}). Exited maze!")
            break

        if (bumped_once or left_entry_tile) and crossed_exit_gate(plan, cur_x, cur_y, target_heading):
            stop_motors()
            print(f"[MAP Pass {pass_num}] Crossed exit gate (s1, s2). Mapping complete!")
            break

        # Detect transition to a new grid square (clearing the previous square)
        if (tx, ty) != cur_tile and tile_in_bounds(tx, ty):
            if not turned_in_cur_tile:
                clear_square_and_mark_walls(cur_tile, target_heading, saw_wall_in_cur_tile)
            cur_tile = (tx, ty)
            if cur_tile != plan["first_tile"]:
                left_entry_tile = True
            enter_street_tile(*cur_tile)
            saw_wall_in_cur_tile = False
            turned_in_cur_tile = False

        # ------------------------------------------------------------------
        # 2. Front Touch Bumper Collision & 180-Deg Exit Verification
        # ------------------------------------------------------------------
        if is_bumper_pressed():
            stop_motors()
            bumped_once = True
            dist_since_turn = cur_trav - last_bump_turn_trav
            front_tile, side_tile, opp_tile = get_adjacent_tiles_for_heading(tx, ty, target_heading)

            if just_turned_from_wall and dist_since_turn < DEAD_END_BUMP_DIST_CM:
                # Hit wall immediately after turning into opposite side -> DEAD END
                mark_wall_box(front_tile[0], front_tile[1], "dead_end_front")
                print(
                    f"[MAP Pass {pass_num}] Dead-end confirmed at {cur_tile}, wall={front_tile}. "
                    f"Completing 180 turnaround."
                )
                back_up(BUMP_BACKUP_CM, target_heading)
                target_heading = snap_cardinal(target_heading + last_turn_dir)
                turn_to_heading(target_heading)

                just_turned_from_wall = False
                last_turn_dir = 0.0
                turned_in_cur_tile = True
            else:
                side_dist = sample_fresh_side_us()
                wall_present = (side_dist is not None and side_dist <= WALL_DETECT_THRESHOLD_CM)
                print(
                    f"[MAP Pass {pass_num}] Front bump at {cur_tile} | {format_sensor_line()} "
                    f"-> side_wall={wall_present}"
                )

                back_up(BUMP_BACKUP_CM, target_heading)

                if wall_present:
                    # Sensor side is walled -> mark front & side wall boxes, turn away
                    mark_wall_box(front_tile[0], front_tile[1], "front_bump")
                    mark_wall_box(side_tile[0], side_tile[1], "bump_side")

                    turn_deg = -90.0 if SIDE_SENSOR_ORIENTATION == "right" else +90.0
                    target_heading = snap_cardinal(target_heading + turn_deg)
                    turn_to_heading(target_heading)

                    just_turned_from_wall = True
                    last_turn_dir = turn_deg
                    turned_in_cur_tile = True
                else:
                    # Distance sensor says there is an open path!
                    # NEW RULE: Do 180, stop 0.5 s, check US for 0.5 s.
                    # If ALSO open -> exited the street! If walled -> mark wall box & enter open side.
                    print(f"[MAP Pass {pass_num}] Side open -> doing 180 check...")
                    turn_by_angle(180.0)
                    opposite_heading = snap_cardinal(target_heading + 180.0)
                    stop_motors()
                    time.sleep(0.5)
                    opp_dist = sample_side_us_duration(0.5)
                    opp_wall_present = (opp_dist is not None and opp_dist <= WALL_DETECT_THRESHOLD_CM)

                    print(
                        f"[MAP-180] After 180 check: US={opp_dist} cm -> opp_wall={opp_wall_present}"
                    )

                    if not opp_wall_present:
                        print(f"[MAP Pass {pass_num}] Both sides open after 180! We got out of the path.")
                        target_heading = opposite_heading
                        break

                    # Still inside 1-tile street: front & opposite side are wall boxes; turn into open path
                    mark_wall_box(front_tile[0], front_tile[1], "front_bump")
                    mark_wall_box(opp_tile[0], opp_tile[1], "180_opp_wall")

                    # From 180 heading, open corridor is -90 (right sensor) or +90 (left sensor)
                    corr_turn = -90.0 if SIDE_SENSOR_ORIENTATION == "right" else +90.0
                    target_heading = snap_cardinal(opposite_heading + corr_turn)
                    turn_to_heading(target_heading)

                    just_turned_from_wall = False
                    last_turn_dir = corr_turn
                    turned_in_cur_tile = True

            _, _, _, new_trav = get_pose()
            last_bump_turn_trav = new_trav
            last_line_trav = new_trav
            blind_cm = BLIND_AFTER_TURN_CM
            heading_sum = 0.0
            heading_cnt = 0
            last_trav = new_trav
            last_prog_t = time.monotonic()
            boost = 0.0
            continue

        # ------------------------------------------------------------------
        # 3. Anti-stall watchdog
        # ------------------------------------------------------------------
        now = time.monotonic()
        if abs(cur_trav - last_trav) > 0.25:
            last_trav = cur_trav
            last_prog_t = now
            boost = 0.0
        elif now - last_prog_t >= STALL_CHECK_SEC:
            boost = min(boost + STALL_BOOST_STEP, MAX_BOOST_POWER - DRIVE_POWER)
            last_prog_t = now

        # ------------------------------------------------------------------
        # 4. Perpendicular Light-Sensor Line Squaring
        # ------------------------------------------------------------------
        heading_sum += wrap180(cur_theta - target_heading)
        heading_cnt += 1

        dist_since_line = cur_trav - last_line_trav
        if dist_since_line >= blind_cm:
            ux, uy = heading_unit_vec(target_heading)
            sensor_pos = (cur_x + ux * SENSOR_OFFSET) if abs(ux) > abs(uy) else (cur_y + uy * SENSOR_OFFSET)
            nearest_line = round(sensor_pos / TILE) * TILE

            if abs(sensor_pos - nearest_line) <= PERP_LINE_TOLERANCE_CM:
                med_l, med_r = get_light_medians()
                if is_left_on_line(med_l) or is_right_on_line(med_r):
                    avg_h = target_heading + (heading_sum / max(1, heading_cnt))
                    ok, line_coord = square_on_line(target_heading, dist_since_line, avg_h)
                    _, _, _, post_trav = get_pose()
                    last_line_trav = post_trav
                    blind_cm = BLIND_AFTER_LINE_CM if ok else 7.0
                    heading_sum = 0.0
                    heading_cnt = 0
                    last_trav = post_trav
                    last_prog_t = time.monotonic()
                    boost = 0.0

                    if ok:
                        just_turned_from_wall = False
                        if (bumped_once or left_entry_tile) and abs(wrap180(target_heading - plan["exit_heading"])) <= 20.0:
                            post_x, post_y, _, _ = get_pose()
                            perp_pos = post_y if plan["gate_axis"] == "vertical" else post_x
                            if (
                                abs(line_coord - plan["gate_line_cm"]) < 2.0
                                and abs(perp_pos - plan["gate_center_perp_cm"]) <= TILE * 0.55
                            ):
                                print(f"[MAP Pass {pass_num}] Squared on exit gate line (s1, s2). Mapping complete!")
                                break
                    continue

        # ------------------------------------------------------------------
        # 5. Smooth Quadratic Ultrasonic Wall Control + Wall Observation
        # ------------------------------------------------------------------
        side_dist = get_filtered_us_cm()
        wall_angle_offset = 0.0

        if side_dist is not None and side_dist <= US_TOO_FAR:
            wall_angle_offset = compute_wall_angle_offset(side_dist, side_mult)
            if side_dist <= WALL_DETECT_THRESHOLD_CM:
                saw_wall_in_cur_tile = True
        else:
            rx, ry = right_unit_vec(target_heading)
            tile_cx = (tx + 0.5) * TILE
            tile_cy = (ty + 0.5) * TILE
            lat_err_cm = (tile_cx - cur_x) * rx + (tile_cy - cur_y) * ry
            wall_angle_offset = clamp(CROSS_TRACK_KP * lat_err_cm, -MAX_CROSS_TRACK_DEG, MAX_CROSS_TRACK_DEG)

        desired_heading = target_heading + wall_angle_offset
        heading_err = wrap180(desired_heading - cur_theta)
        steer = clamp(HEADING_KP * heading_err, -MAX_STEER_DELTA, MAX_STEER_DELTA)

        base_p = DRIVE_POWER + boost
        left_pwr = base_p + steer
        right_pwr = base_p - steer
        set_drive_powers(left_pwr, right_pwr)

        if now - last_dbg >= SENSOR_PRINT_INTERVAL:
            print(
                f"{format_sensor_line()} | tile={cur_tile} "
                f"hdg={cur_theta:.1f}->{desired_heading:.1f} pwr=({left_pwr:.0f},{right_pwr:.0f})"
            )
            last_dbg = now

        time.sleep(LOOP_SECONDS)

    stop_motors()


