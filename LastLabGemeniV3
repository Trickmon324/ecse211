# 11. DIJKSTRA GRID NAVIGATION & POST-MAPPING MODES (MODE 1 / MODE 2)
# ==============================================================================
def build_unique_street_tiles():
    unique = []
    seen = set()
    for t in street_tiles:
        if t not in seen and tile_in_bounds(*t):
            seen.add(t)
            unique.append(t)
    return unique


def find_safe_tile_path(start_tile, goal_tile, blocked_tiles, prefer_outside_street=True):
    """Dijkstra shortest path on 9x5 tile grid avoiding all wall boxes & minimizing turns."""
    start = clamp_tile_in_bounds(*start_tile)
    goal = clamp_tile_in_bounds(*goal_tile)
    blocked = set(blocked_tiles) - {start, goal}
    street_set = set(street_tiles)

    # State: (cost, tile, prev_dir, path)
    pq = [(0, start, None, [start])]
    best = {}

    while pq:
        cost, cur, pdir, path = heapq.heappop(pq)
        if cur == goal:
            return path
        state = (cur, pdir)
        if state in best and best[state] <= cost:
            continue
        best[state] = cost

        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nxt = (cur[0] + dx, cur[1] + dy)
            if not tile_in_bounds(*nxt) or nxt in blocked:
                continue
            step_cost = 10
            if pdir is not None and pdir != (dx, dy):
                step_cost += 4  # Prefer fewer 90-deg turns
            if prefer_outside_street and nxt in street_set:
                step_cost += 20  # Prefer open floor over driving back through the street
            heapq.heappush(pq, (cost + step_cost, nxt, (dx, dy), path + [nxt]))

    return []


def navigate_tile_path(tile_path):
    """Drive cleanly through tile centers using line squaring and cross-track control."""
    if not tile_path:
        return False

    # First center safely in start tile
    sx, sy = (tile_path[0][0] + 0.5) * TILE, (tile_path[0][1] + 0.5) * TILE
    cur_x, cur_y, _, _ = get_pose()
    dx0, dy0 = sx - cur_x, sy - cur_y
    if abs(dx0) > 2.5:
        drive_to_point_cardinal(sx, cur_y, 90.0 if dx0 > 0 else 270.0, use_line_squaring=False)
    cur_x, cur_y, _, _ = get_pose()
    dy0 = sy - cur_y
    if abs(dy0) > 2.5:
        drive_to_point_cardinal(sx, sy, 0.0 if dy0 > 0 else 180.0, use_line_squaring=False)

    # Now drive straight across merged collinear tile segments
    i = 0
    while i < len(tile_path) - 1 and not shutdown.is_set():
        dx = tile_path[i + 1][0] - tile_path[i][0]
        dy = tile_path[i + 1][1] - tile_path[i][1]
        j = i + 1
        while j < len(tile_path) - 1:
            if (tile_path[j + 1][0] - tile_path[j][0], tile_path[j + 1][1] - tile_path[j][1]) == (dx, dy):
                j += 1
            else:
                break

        tx, ty = tile_path[j]
        target_x = (tx + 0.5) * TILE
        target_y = (ty + 0.5) * TILE
        hdg = vec_to_heading(dx, dy)
        drive_to_point_cardinal(target_x, target_y, hdg, use_line_squaring=True, initial_blind_cm=BLIND_AFTER_TURN_CM)
        i = j

    return True


def run_post_mode_1_dropoff(d1, d2, plan):
    """
    Mode 1 (Test Run): Navigate safely around mapped wall boxes to (d1, d2),
    turn so the robot's BACK faces the drop-off bucket, back up slightly, and stop.
    """
    print("\n[MODE 1] Navigating to snow drop-off location and parking back at bucket...")
    drop_tile, park_heading = compute_dropoff_plan(d1, d2)

    cur_x, cur_y, _, _ = get_pose()
    cur_tile = clamp_tile_in_bounds(*coord_to_tile(cur_x, cur_y))

    path = find_safe_tile_path(cur_tile, drop_tile, wall_boxes.keys(), prefer_outside_street=True)
    if not path:
        print("[WARN] Blocked in Mode 1; retrying without street penalty.")
        path = find_safe_tile_path(cur_tile, drop_tile, wall_boxes.keys(), prefer_outside_street=False)

    print(f"[MODE 1] Safe path {cur_tile} -> {drop_tile}: {path}")
    navigate_tile_path(path)

    turn_to_heading(park_heading)
    back_up(DROP_OFF_PARK_BACKUP_CM, park_heading)
    stop_motors()
    print(f"[MODE 1] Parked back at drop-off {d1}-{d2} (heading={park_heading} deg). Stopped.")


def run_post_mode_2_double_pass(plan):
    """
    Mode 2 (Double Pass): Navigate safely back to (s1, s2), re-enter the street
    for a second verification pass, exit, and return cleanly to (0, 0).
    """
    print("\n[MODE 2] Starting Double-Pass Verification...")
    pass1_tiles = set(build_unique_street_tiles())
    pass1_walls = {k: dict(v) for k, v in wall_boxes.items()}

    cur_x, cur_y, _, _ = get_pose()
    cur_tile = clamp_tile_in_bounds(*coord_to_tile(cur_x, cur_y))

    stage_tile = plan["stage_tile"]
    path_to_gate = find_safe_tile_path(cur_tile, stage_tile, wall_boxes.keys(), prefer_outside_street=True)
    if path_to_gate:
        print(f"[MODE 2] Returning to street entrance staging tile {stage_tile}: {path_to_gate}")
        navigate_tile_path(path_to_gate)

    # Align exactly with gate staging point & re-enter street
    sx, sy = plan["stage_pt"]
    cur_x, cur_y, _, _ = get_pose()
    if math.hypot(sx - cur_x, sy - cur_y) > 2.0:
        dx, dy = sx - cur_x, sy - cur_y
        hdg = (90.0 if dx > 0 else 270.0) if abs(dx) >= abs(dy) else (0.0 if dy > 0 else 180.0)
        drive_to_point_cardinal(sx, sy, hdg, use_line_squaring=True, initial_blind_cm=BLIND_AFTER_TURN_CM)

    ftx, fty = plan["first_tile_center"]
    drive_to_point_cardinal(ftx, fty, plan["entry_heading"], use_line_squaring=True, initial_blind_cm=4.0)

    # Run Pass 2 (keeps and verifies/updates wall_boxes & street_tiles)
    map_street(plan, pass_num=2, reset_map=True)
    pass2_tiles = set(build_unique_street_tiles())
    pass2_walls = set(wall_boxes.keys())

    # Reconcile Pass 1 and Pass 2
    final_tiles = pass1_tiles | pass2_tiles
    for wt in final_tiles:
        if wt in wall_boxes:
            del wall_boxes[wt]
    for k, v in pass1_walls.items():
        if k not in final_tiles and k not in wall_boxes:
            wall_boxes[k] = v

    print(
        f"[VERIFY] Pass 1 tiles={len(pass1_tiles)}, Pass 2 tiles={len(pass2_tiles)} | "
        f"Pass 1 walls={len(pass1_walls)}, Pass 2 walls={len(pass2_walls)}"
    )
    if pass1_tiles == pass2_tiles and set(pass1_walls.keys()) == pass2_walls:
        print("[VERIFY] Double pass 100% consistent!")
    else:
        print("[VERIFY] Merged & reconciled Pass 1 + Pass 2 maps.")

    navigate_entrance_to_origin(plan)


def save_and_print_map(plan, d1, d2, post_mode):
    unique_tiles = build_unique_street_tiles()
    serialized_boxes = [
        {"tile": list(k), "corners": [list(c) for c in v["corners"]], "source": v["source"]}
        for k, v in sorted(wall_boxes.items())
    ]

    data = {
        "s1": list(plan["s1"]),
        "s2": list(plan["s2"]),
        "d1": list(d1),
        "d2": list(d2),
        "post_mapping_mode": post_mode,
        "street_tiles": [list(t) for t in unique_tiles],
        "wall_boxes": serialized_boxes,
    }
    with open(MAP_SAVE_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)

    print("\n" + "=" * 62)
    print("PHASE 1 MAPPED STREET & WALL BOXES SUMMARY")
    print(f"Street tiles ({len(unique_tiles)}): {unique_tiles}")
    print(f"Wall boxes ({len(serialized_boxes)}) saved to {MAP_SAVE_FILE}:")
    for wb in serialized_boxes:
        print(f"  Wall {tuple(wb['tile'])}: corners={wb['corners']} ({wb['source']})")

    tile_set = set(unique_tiles)
    for ty in range(MAP_Y_MAX - 1, MAP_Y_MIN - 1, -1):
        row = f"y={ty:2d} | "
        for tx in range(MAP_X_MIN, MAP_X_MAX):
            if (tx, ty) == plan["first_tile"]:
                row += " E "
            elif (tx, ty) in tile_set:
                row += " . "
            elif (tx, ty) in wall_boxes:
                row += " # "
            else:
                row += " o "  # Open / unblocked
        print(row)
    print("     +" + "---" * (MAP_X_MAX - MAP_X_MIN))
    print("       " + "".join(f"{tx:2d} " for tx in range(MAP_X_MIN, MAP_X_MAX)))
    print("Legend: E=Entry, .=Street, #=Mapped Wall Box, o=Open")
    print("=" * 62 + "\n")
    return data


