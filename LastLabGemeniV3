# ==============================================================================
# 5. MATH & HARDWARE HELPERS
# ==============================================================================
def wrap180(angle_deg):
    return (angle_deg + 180.0) % 360.0 - 180.0


def clamp(val, lo, hi):
    return max(lo, min(hi, val))


def snap_cardinal(angle_deg):
    return round(angle_deg / 90.0) * 90.0 % 360.0


def heading_unit_vec(heading_deg):
    rad = math.radians(heading_deg)
    return math.sin(rad), math.cos(rad)


def right_unit_vec(heading_deg):
    ux, uy = heading_unit_vec(heading_deg)
    return uy, -ux


def coord_to_tile(px_cm, py_cm):
    return int(math.floor(px_cm / TILE)), int(math.floor(py_cm / TILE))


def tile_in_bounds(tx, ty):
    return MAP_X_MIN <= tx < MAP_X_MAX and MAP_Y_MIN <= ty < MAP_Y_MAX


def clamp_tile_in_bounds(tx, ty):
    return int(clamp(tx, MAP_X_MIN, MAP_X_MAX - 1)), int(clamp(ty, MAP_Y_MIN, MAP_Y_MAX - 1))


def tile_corners(tx, ty):
    return [(tx, ty), (tx, ty + 1), (tx + 1, ty + 1), (tx + 1, ty)]


def read_encoder_deg(motor):
    try:
        if hasattr(motor, "get_position"):
            val = motor.get_position()
        elif hasattr(motor, "get_encoder"):
            val = motor.get_encoder()
        else:
            raise AttributeError("Motor has neither get_position nor get_encoder")
        return None if val is None else float(val)
    except Exception:
        return None


def zero_encoder(motor):
    if hasattr(motor, "reset_encoder"):
        motor.reset_encoder()


def set_drive_powers(left_pwr, right_pwr):
    left_motor.set_power(int(round(clamp(left_pwr, -100, 100))))
    right_motor.set_power(int(round(clamp(right_pwr, -100, 100))))


def stop_motors():
    if left_motor is not None:
        left_motor.set_power(0)
    if right_motor is not None:
        right_motor.set_power(0)


def is_bumper_pressed():
    try:
        if hasattr(touch_sensor, "get_value"):
            val = touch_sensor.get_value()
        elif hasattr(touch_sensor, "is_pressed"):
            val = touch_sensor.is_pressed()
        else:
            val = 0
        return val == 1 or val is True
    except Exception:
        return False


def read_light_sum(sensor):
    try:
        rgb = sensor.get_rgb()
        if rgb is not None and len(rgb) >= 3 and all(v is not None for v in rgb[:3]):
            return float(rgb[0] + rgb[1] + rgb[2])
    except Exception:
        pass
    return None


def read_raw_us_cm():
    try:
        d = side_us.get_cm()
        if d is not None and 0.0 < d <= 255.0:
            return float(d)
    except Exception:
        pass
    return None


def get_pose():
    with odo_lock:
        return x_cm, y_cm, theta_deg, travel_cm


def set_pose(new_x, new_y, new_theta):
    global x_cm, y_cm, theta_deg
    with odo_lock:
        x_cm = float(new_x)
        y_cm = float(new_y)
        theta_deg = float(new_theta) % 360.0


def get_light_medians():
    with sensor_lock:
        med_l = statistics.median(left_rgb_buf) if left_rgb_buf else None
        med_r = statistics.median(right_rgb_buf) if right_rgb_buf else None
    return med_l, med_r


def is_left_on_line(med_l):
    return med_l is not None and med_l < (WHITE_LEFT - LINE_DROP)


def is_right_on_line(med_r):
    return med_r is not None and med_r < (WHITE_RIGHT - LINE_DROP)


def get_filtered_us_cm():
    with sensor_lock:
        if not us_buf:
            return None
        return statistics.median(us_buf)


def format_sensor_line():
    us_val = get_filtered_us_cm()
    med_l, med_r = get_light_medians()
    us_str = f"{us_val:.1f} cm" if us_val is not None else "None"
    r_str = f"{med_r:.0f}" if med_r is not None else "None"
    l_str = f"{med_l:.0f}" if med_l is not None else "None"
    return f"Distance sensor: {us_str} ; Right Light sensor: {r_str} ; Left light sensor: {l_str}"


def sample_fresh_side_us(num_samples=US_FILTER_SAMPLES):
    with sensor_lock:
        us_buf.clear()
    samples = []
    deadline = time.monotonic() + 0.25
    while len(samples) < num_samples and time.monotonic() < deadline:
        val = read_raw_us_cm()
        if val is not None:
            samples.append(val)
            with sensor_lock:
                us_buf.append(val)
        time.sleep(0.015)
    if not samples:
        return None
    return statistics.median(samples)


def sample_side_us_duration(duration_s=0.5):
    """Collect side US readings continuously for duration_s while stationary."""
    with sensor_lock:
        us_buf.clear()
    samples = []
    deadline = time.monotonic() + duration_s
    while time.monotonic() < deadline and not shutdown.is_set():
        val = read_raw_us_cm()
        if val is not None:
            samples.append(val)
            with sensor_lock:
                us_buf.append(val)
        time.sleep(0.02)
    if not samples:
        return None
    return statistics.median(samples)


def compute_wall_angle_offset(side_dist, side_mult):
    err_us = side_dist - US_BAND_CENTER
    if abs(err_us) <= US_DEADBAND_CM:
        return 0.0

    eff_err = err_us - math.copysign(US_DEADBAND_CM, err_us)
    angle = side_mult * WALL_QUAD_KP * (eff_err * abs(eff_err))

    if side_dist <= US_TOO_CLOSE and abs(angle) < URGENT_WALL_ANGLE_DEG:
        angle = -side_mult * URGENT_WALL_ANGLE_DEG

    return clamp(angle, -MAX_WALL_ANGLE_DEG, MAX_WALL_ANGLE_DEG)


