def run_calibrate_turn():
    print("\n=== MODE: calibrate_turn ===")
    target_deg = float(input("Enter target turn angle in deg (e.g. 720 or 1080): "))
    pwr = float(input(f"Enter turn power (default {CALIB_TURN_POWER}): ") or CALIB_TURN_POWER)

    _, _, start_theta, _ = get_pose()
    turn_by_angle(target_deg, base_power=pwr)
    actual_deg = float(input("Enter ACTUAL angle rotated physically (deg): "))
    if abs(actual_deg) > 1e-3:
        print(f"Suggested TURN_FACTOR multiplier: {target_deg / actual_deg:.5f}")
    print(f"Odometry final theta: {get_pose()[2]:.2f} deg (started at {start_theta:.2f})")


def run_calibrate_straight():
    print("\n=== MODE: calibrate_straight ===")
    tiles = float(input(f"Tiles to drive (default {CALIB_STRAIGHT_TILES}): ") or CALIB_STRAIGHT_TILES)
    dist_target = tiles * TILE

    with odo_lock:
        l0 = left_distance_cm
        r0 = right_distance_cm
        t0 = travel_cm

    while not shutdown.is_set():
        with odo_lock:
            traveled = travel_cm - t0
        if traveled >= dist_target or is_bumper_pressed():
            break
        set_drive_powers(DRIVE_POWER, DRIVE_POWER)
        time.sleep(LOOP_SECONDS)

    stop_motors()
    with odo_lock:
        dl = left_distance_cm - l0
        dr = right_distance_cm - r0

    print(f"Left travel: {dl:.3f} cm | Right travel: {dr:.3f} cm")
    if abs(dr) > 1e-3:
        print(f"Suggested RIGHT_WHEEL_SCALE = {dl / dr:.6f}")


def run_calibrate_light_squaring():
    print("\n=== MODE: calibrate_light_squaring ===")
    _, _, start_theta, start_trav = get_pose()
    heading_sum = 0.0
    heading_cnt = 0

    while not shutdown.is_set():
        if is_bumper_pressed():
            print("Bumper hit before finding line.")
            break
        _, _, cur_theta, cur_trav = get_pose()
        heading_sum += wrap180(cur_theta - start_theta)
        heading_cnt += 1

        med_l, med_r = get_light_medians()
        if is_left_on_line(med_l) or is_right_on_line(med_r):
            leg_len = cur_trav - start_trav
            avg_h = start_theta + (heading_sum / max(1, heading_cnt))
            ok, line_coord = square_on_line(snap_cardinal(start_theta), leg_len, avg_h, verbose=True)
            if ok:
                print(f"Squared on line={line_coord:.2f} cm. Advancing {POST_LINE_TILE_CENTER_CM:.2f} cm...")
                creep_forward(POST_LINE_TILE_CENTER_CM, snap_cardinal(start_theta), stop_on_bump=True)
            break

        err = wrap180(start_theta - cur_theta)
        corr = HEADING_KP * err
        set_drive_powers(DRIVE_POWER + corr, DRIVE_POWER - corr)
        time.sleep(LOOP_SECONDS)

    stop_motors()


