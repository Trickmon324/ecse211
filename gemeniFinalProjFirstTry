# 12. CALIBRATION ROUTINES
# =======================================================================
def calibrate_turn_routine():
    """
    Calibrates TRACK_WIDTH and turn factors.
    Supports angles > 360 degrees (e.g. 720, 1080) for precision tuning.
    """
    print("\n--- MULTI-ROTATION TURN CALIBRATION ---")
    print(f"Target Angle: {CALIB_TURN_ANGLE:.1f} deg | Power: {CALIB_TURN_POWER}")
    input("Place robot with reference pointer aligned on line. Press ENTER to start turn...")

    start_s = motion_state()
    turn_by(CALIB_TURN_ANGLE, power=CALIB_TURN_POWER)
    end_s = motion_state()

    odo_deg = abs(encoder_heading_change(end_s[3] - start_s[3], end_s[4] - start_s[4]))
    print(f"\nTurn Finished:")
    print(f"  Target:            {CALIB_TURN_ANGLE:.2f} deg")
    print(f"  Odometer Measured: {odo_deg:.2f} deg")
    ratio = odo_deg / CALIB_TURN_ANGLE
    print(f"  Scale Correction:  Multiply TURN_FACTOR by {ratio:.4f}")
    print("Adjust RIGHT_TURN_FACTOR or TRACK_WIDTH in script constants.")


def calibrate_straight_routine():
    """
    Drives forward for CALIB_STRAIGHT_TILES.
    Compares left vs right wheel encoder travel to tune RIGHT_WHEEL_SCALE.
    """
    print("\n--- STRAIGHT DRIVE & MOTOR BALANCE CALIBRATION ---")
    dist_cm = CALIB_STRAIGHT_TILES * TILE
    print(f"Driving straight for {dist_cm:.1f} cm ({CALIB_STRAIGHT_TILES} tiles)...")
    input("Align robot on grid line. Press ENTER to drive...")

    start_s = motion_state()
    left_motor.set_power(DRIVE_POWER)
    right_motor.set_power(DRIVE_POWER)

    try:
        while motion_state()[5] - start_s[5] < dist_cm:
            time.sleep(LOOP_SECONDS)
    finally:
        stop()

    end_s = motion_state()
    dl = end_s[3] - start_s[3]
    dr = end_s[4] - start_s[4]
    print(f"\nStraight Test Complete:")
    print(f"  Left Wheel Traveled:  {dl:.2f} cm")
    print(f"  Right Wheel Traveled: {dr:.2f} cm")
    print(f"  Ratio (Left / Right): {dl / dr if dr != 0 else 0:.4f}")
    print("Update RIGHT_WHEEL_SCALE to equalize both wheels.")


def calibrate_light_squaring_routine():
    """
    Drives forward, hits a line, performs one-motor squaring, executes drift math,
    prints full alignment diagnostics, and advances forward to test the next line.
    """
    print("\n--- LIGHT SENSORS & LINE SQUARING CALIBRATOR ---")
    print("Robot will advance, square up on line, print error math, and stop.")
    input("Place robot 15-20 cm behind a dark grid line. Press ENTER...")

    state = motion_state()
    start_fwd = state[1]
    align = None

    left_motor.set_power(DRIVE_POWER)
    right_motor.set_power(DRIVE_POWER)

    try:
        while True:
            l_on = on_line(left_light)
            r_on = on_line(right_light)

            if align is None and (l_on or r_on):
                align = {
                    "L": l_on, "R": r_on,
                    "theta": motion_state()[2],
                    "time": time.monotonic(),
                    "leg_dist": abs(motion_state()[1] - start_fwd)
                }

            if align is not None:
                align["L"] = align["L"] or l_on
                align["R"] = align["R"] or r_on
                left_motor.set_power(0 if align["L"] else ALIGN_POWER)
                right_motor.set_power(0 if align["R"] else ALIGN_POWER)

                if align["L"] and align["R"]:
                    stop()
                    time.sleep(0.1)
                    pivot = wrap180(motion_state()[2] - align["theta"])
                    tilt_deg = -pivot * (1.0 + ALIGN_LEVER_RATIO)
                    drift_cm = align["leg_dist"] * math.sin(math.radians(tilt_deg))
                    print("\n--> SQUARING COMPLETE!")
                    print(f"  Pivot Angle Difference: {pivot:+.2f} deg")
                    print(f"  Calculated Approach Tilt:{tilt_deg:+.2f} deg")
                    print(f"  Leg Distance Traveled:  {align['leg_dist']:.2f} cm")
                    print(f"  Computed Lateral Drift: {drift_cm:+.2f} cm")

                    # Advance post-line distance
                    print(f"  Creeping post-line distance: {POST_LINE_FORWARD_CM:.1f} cm")
                    creep_forward(POST_LINE_FORWARD_CM)
                    print("  Ready for turn or next action.\n")
                    break

            time.sleep(LOOP_SECONDS)

    finally:
        stop()


# =======================================================================
# 13. MAIN ENTRY POINT
# =======================================================================
if __name__ == "__main__":
    odo_thread = None
    try:
        init_odometer()

        # Prime light sensor buffers
        for _ in range(LIGHT_FILTER_SAMPLES):
            get_filtered_light(left_light)
            get_filtered_light(right_light)
            time.sleep(0.01)

        # Start continuous background odometry
        odo_thread = Thread(target=odometer_thread_loop, daemon=True)
        odo_thread.start()

        # Execute chosen operational mode
        if RUN_MODE == "map":
            run_mapping_phase()
        elif RUN_MODE == "calibrate_turn":
            calibrate_turn_routine()
        elif RUN_MODE == "calibrate_straight":
            calibrate_straight_routine()
        elif RUN_MODE == "calibrate_light_squaring":
            calibrate_light_squaring_routine()
        else:
            raise ValueError(f"Unknown RUN_MODE: {RUN_MODE}")

    except KeyboardInterrupt:
        print("\nProcess interrupted by user.")
    finally:
        stop()
        shutdown.set()
        if odo_thread:
            odo_thread.join(timeout=0.3)
        reset_brick()
        print("Brick reset and motors safely stopped.")
