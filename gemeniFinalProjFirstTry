def build_unique_street_tiles():
    unique = []
    seen = set()
    for t in street_tiles:
        if t not in seen and MAP_X_MIN <= t[0] < MAP_X_MAX and MAP_Y_MIN <= t[1] < MAP_Y_MAX:
            seen.add(t)
            unique.append(t)
    return unique


def save_and_print_map(plan, d1, d2):
    unique_tiles = build_unique_street_tiles()
    data = {
        "s1": list(plan["s1"]),
        "s2": list(plan["s2"]),
        "d1": list(d1),
        "d2": list(d2),
        "street_tiles": [list(t) for t in unique_tiles],
        "discovered_walls": [[list(e[0]), list(e[1])] for e in sorted(discovered_walls)],
    }
    with open(MAP_SAVE_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)

    print("\n" + "=" * 55)
    print("PHASE 1 MAPPED STREET SUMMARY")
    print(f"Unique street tiles ({len(unique_tiles)}): {unique_tiles}")
    print(f"Discovered wall segments ({len(discovered_walls)}) saved to {MAP_SAVE_FILE}")

    tile_set = set(unique_tiles)
    for ty in range(MAP_Y_MAX - 1, MAP_Y_MIN - 1, -1):
        row = f"y={ty:2d} | "
        for tx in range(MAP_X_MIN, MAP_X_MAX):
            if (tx, ty) == plan["first_tile"]:
                row += " E "
            elif (tx, ty) in tile_set:
                row += " . "
            else:
                row += " # "
        print(row)
    print("     +" + "---" * (MAP_X_MAX - MAP_X_MIN))
    print("       " + "".join(f"{tx:2d} " for tx in range(MAP_X_MIN, MAP_X_MAX)))
    print("=" * 55 + "\n")
    return data


def bfs_street_path(start_tile, goal_tile, allowed_tiles):
    allowed = set(allowed_tiles)
    if start_tile not in allowed or goal_tile not in allowed:
        return []
    q = deque([[start_tile]])
    visited = {start_tile}
    while q:
        path = q.popleft()
        cur = path[-1]
        if cur == goal_tile:
            return path
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nxt = (cur[0] + dx, cur[1] + dy)
            if nxt in allowed and nxt not in visited:
                visited.add(nxt)
                q.append(path + [nxt])
    return []


def run_phase2_placeholder(plan, d1, d2, map_data):
    print("\n[PHASE 2] Ready for snow removal (non-contact mode).")
    print(f"[PHASE 2] Drop-off edge: d1={d1}, d2={d2}")
    unique_tiles = [tuple(t) for t in map_data["street_tiles"]]
    if len(unique_tiles) >= 2:
        deepest_tile = unique_tiles[len(unique_tiles) // 2]
        path_in = bfs_street_path(plan["first_tile"], deepest_tile, unique_tiles)
        print(f"[PHASE 2] Sample BFS path into street: {path_in}")
    print("[PHASE 2] Add your pickup/bucket-dropoff mechanism routine here.")


