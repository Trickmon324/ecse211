# 10. WALL LOGGING & PHASE 1 STREET MAPPING ENGINE
# ==============================================================================
def log_front_wall(heading_deg):
    cx, cy, _, _ = get_pose()
    ux, uy = heading_unit_vec(heading_deg)
    hit_x = cx + ux * TOUCH_SENSOR_OFFSET_CM
    hit_y = cy + uy * TOUCH_SENSOR_OFFSET_CM

    if abs(ux) > abs(uy):
        gx = int(round(hit_x / TILE))
        gy = int(math.floor(cy / TILE))
        edge = normalize_wall_edge((gx, gy), (gx, gy + 1))
    else:
        gy = int(round(hit_y / TILE))
        gx = int(math.floor(cx / TILE))
        edge = normalize_wall_edge((gx, gy), (gx + 1, gy))

    discovered_walls.add(edge)
    return edge


def log_side_wall(heading_deg, tx, ty):
    rx, ry = right_unit_vec(heading_deg)
    side_mult = 1.0 if SIDE_SENSOR_ORIENTATION == "right" else -1.0
    sx, sy = int(round(rx * side_mult)), int(round(ry * side_mult))

    if sx == 1:
        edge = normalize_wall_edge((tx + 1, ty), (tx + 1, ty + 1))
    elif sx == -1:
        edge = normalize_wall_edge((tx, ty), (tx, ty + 1))
    elif sy == 1:
        edge = normalize_wall_edge((tx, ty + 1), (tx + 1, ty + 1))
    else:
        edge = normalize_wall_edge((tx, ty), (tx + 1, ty))

    discovered_walls.add(edge)
    return edge


def crossed_exit_gate(plan, cur_x, cur_y, cur_heading):
    if abs(wrap180(cur_heading - plan["exit_heading"])) > 20.0:
        return False

    ex_ux, ex_uy = heading_unit_vec(plan["exit_heading"])
    gate_line = plan["gate_line_cm"]
    gate_perp = plan["gate_center_perp_cm"]

    if plan["gate_axis"] == "vertical":
        perp_ok = abs(cur_y - gate_perp) <= (TILE * 0.55)
        dist_outside = (cur_x - gate_line) * ex_ux
    else:
        perp_ok = abs(cur_x - gate_perp) <= (TILE * 0.55)
        dist_outside = (cur_y - gate_line) * ex_uy

    return perp_ok and dist_outside >= 2.0


def map_street(plan):
    discovered_walls.clear()
    street_tiles.clear()

    target_heading = plan["entry_heading"]
    side_mult = 1.0 if SIDE_SENSOR_ORIENTATION == "right" else -1.0

    _, _, _, start_trav = get_pose()
    last_line_trav = start_trav
    last_bump_turn_trav = start_trav
    blind_cm = BLIND_AFTER_TURN_CM

    heading_sum = 0.0
    heading_cnt = 0

    bumped_once = False
    just_turned_from_wall = False
    last_turn_dir = 0.0
    left_entry_tile = False

    last_prog_t = time.monotonic()
    last_trav = start_trav
    boost = 0.0
    last_dbg = last_prog_t

    street_tiles.append(plan["first_tile"])
    sample_fresh_side_us()
    print("[MAP] Starting street mapping...")

    while not shutdown.is_set():
        cur_x, cur_y, cur_theta, cur_trav = get_pose()
        tx, ty = coord_to_tile(cur_x, cur_y)

        if not street_tiles or street_tiles[-1] != (tx, ty):
            if (tx, ty) != plan["first_tile"]:
                left_entry_tile = True
            if not crossed_exit_gate(plan, cur_x, cur_y, target_heading):
                street_tiles.append((tx, ty))

        # 1. Exit Detection
        if (bumped_once or left_entry_tile) and crossed_exit_gate(plan, cur_x, cur_y, target_heading):
            stop_motors()
            print("[MAP] Detected exit back across (s1, s2). Mapping complete!")
            break

        # 2. Front Touch Bumper Collision & Decision Tree
        if is_bumper_pressed():
            stop_motors()
            bumped_once = True
            front_edge = log_front_wall(target_heading)
            dist_since_turn = cur_trav - last_bump_turn_trav

            if just_turned_from_wall and dist_since_turn < DEAD_END_BUMP_DIST_CM:
                print(
                    f"[MAP] Dead-end confirmed (wall={front_edge}, "
                    f"dist={dist_since_turn:.1f} cm). Completing 180 turnaround."
                )
                back_up(BUMP_BACKUP_CM, target_heading)
                target_heading = snap_cardinal(target_heading + last_turn_dir)
                turn_to_heading(target_heading)

                just_turned_from_wall = False
                last_turn_dir = 0.0
            else:
                side_dist = sample_fresh_side_us()
                wall_present = (side_dist is not None and side_dist <= WALL_DETECT_THRESHOLD_CM)
                if wall_present:
                    log_side_wall(target_heading, tx, ty)

                print(
                    f"[MAP] Bump wall={front_edge} | side_us={side_dist} cm "
                    f"-> side_wall={wall_present}"
                )

                back_up(BUMP_BACKUP_CM, target_heading)

                if SIDE_SENSOR_ORIENTATION == "right":
                    turn_deg = +90.0 if not wall_present else -90.0
                else:
                    turn_deg = -90.0 if not wall_present else +90.0

                target_heading = snap_cardinal(target_heading + turn_deg)
                turn_to_heading(target_heading)

                just_turned_from_wall = wall_present
                last_turn_dir = turn_deg

            _, _, _, new_trav = get_pose()
            last_bump_turn_trav = new_trav
            last_line_trav = new_trav
            blind_cm = BLIND_AFTER_TURN_CM
            heading_sum = 0.0
            heading_cnt = 0
            last_trav = new_trav
            last_prog_t = time.monotonic()
            boost = 0.0
            continue

        # 3. Anti-stall watchdog
        now = time.monotonic()
        if abs(cur_trav - last_trav) > 0.25:
            last_trav = cur_trav
            last_prog_t = now
            boost = 0.0
        elif now - last_prog_t >= STALL_CHECK_SEC:
            boost = min(boost + STALL_BOOST_STEP, MAX_BOOST_POWER - DRIVE_POWER)
            last_prog_t = now

        # 4. Perpendicular Light-Sensor Line Squaring
        heading_sum += wrap180(cur_theta - target_heading)
        heading_cnt += 1

        dist_since_line = cur_trav - last_line_trav
        if dist_since_line >= blind_cm:
            ux, uy = heading_unit_vec(target_heading)
            sensor_pos = (cur_x + ux * SENSOR_OFFSET) if abs(ux) > abs(uy) else (cur_y + uy * SENSOR_OFFSET)
            nearest_line = round(sensor_pos / TILE) * TILE

            if abs(sensor_pos - nearest_line) <= PERP_LINE_TOLERANCE_CM:
                med_l, med_r = get_light_medians()
                if is_left_on_line(med_l) or is_right_on_line(med_r):
                    avg_h = target_heading + (heading_sum / max(1, heading_cnt))
                    ok, line_coord = square_on_line(target_heading, dist_since_line, avg_h)
                    _, _, _, post_trav = get_pose()
                    last_line_trav = post_trav
                    blind_cm = BLIND_AFTER_LINE_CM if ok else 7.0
                    heading_sum = 0.0
                    heading_cnt = 0
                    last_trav = post_trav
                    last_prog_t = time.monotonic()
                    boost = 0.0

                    if ok:
                        just_turned_from_wall = False
                        if (bumped_once or left_entry_tile) and abs(wrap180(target_heading - plan["exit_heading"])) <= 20.0:
                            post_x, post_y, _, _ = get_pose()
                            perp_pos = post_y if plan["gate_axis"] == "vertical" else post_x
                            if (
                                abs(line_coord - plan["gate_line_cm"]) < 2.0
                                and abs(perp_pos - plan["gate_center_perp_cm"]) <= TILE * 0.55
                            ):
                                print("[MAP] Squared on exit gate line (s1, s2). Mapping complete!")
                                break
                    continue

        # 5. Closed-Loop Cardinal Heading Hold + Side Wall Tracking
        heading_err = wrap180(target_heading - cur_theta)
        heading_corr = HEADING_KP * heading_err

        side_dist = get_filtered_us_cm()
        wall_bias = 0.0
        if side_dist is not None:
            if side_dist <= US_TOO_CLOSE:
                wall_bias = -side_mult * MAX_WALL_BIAS
            elif side_dist <= US_TOO_FAR:
                err_us = side_dist - US_BAND_CENTER
                wall_bias = clamp(side_mult * SIDE_WALL_KP * err_us, -MAX_WALL_BIAS, MAX_WALL_BIAS)
            else:
                wall_bias = 0.0

            if side_dist <= WALL_DETECT_THRESHOLD_CM:
                log_side_wall(target_heading, tx, ty)

        base_p = DRIVE_POWER + boost
        left_pwr = base_p + heading_corr + wall_bias
        right_pwr = base_p - heading_corr - wall_bias
        set_drive_powers(left_pwr, right_pwr)

        if now - last_dbg >= 1.0:
            print(f"[MAP-DBG] tile=({tx},{ty}) hdg={cur_theta:.1f} us={side_dist} pwr=({left_pwr:.0f},{right_pwr:.0f})")
            last_dbg = now

        time.sleep(LOOP_SECONDS)

    stop_motors()


