def init_hardware():
    global left_motor, right_motor, left_light, right_light, touch_sensor, side_us

    print("[INIT] Creating BrickPi3 motor and sensor objects...")
    left_motor = Motor(LEFT_MOTOR_PORT)
    right_motor = Motor(RIGHT_MOTOR_PORT)
    left_light = EV3ColorSensor(LEFT_LIGHT_PORT)
    touch_sensor = TouchSensor(TOUCH_PORT)
    side_us = EV3UltrasonicSensor(US_PORT)
    right_light = EV3ColorSensor(RIGHT_LIGHT_PORT)

    zero_encoder(left_motor)
    zero_encoder(right_motor)

    print("[INIT] Waiting for BrickPi3 sensors to become ready...")
    wait_ready_sensors()
    print("[INIT] All sensors ready!")


def main():
    init_hardware()
    set_pose(0.0, 0.0, START_HEADING_DEG)

    odo_thread = Thread(target=odometer_thread_loop, daemon=True)
    odo_thread.start()
    wait_for_initial_sensors()

    print(f"[START] RUN_MODE='{RUN_MODE}' | Start pose=(0.0, 0.0, {START_HEADING_DEG:.1f} deg)")

    if RUN_MODE == "calibrate_turn":
        run_calibrate_turn()
    elif RUN_MODE == "calibrate_straight":
        run_calibrate_straight()
    elif RUN_MODE == "calibrate_light_squaring":
        run_calibrate_light_squaring()
    elif RUN_MODE == "map":
        print("\nEnter facilitator coordinates (grid units x in [-1,8], y in [-1,4]):")
        s1 = parse_coord_pair("  s1 (x y): ")
        s2 = parse_coord_pair("  s2 (x y): ")
        d1 = parse_coord_pair("  d1 (x y): ")
        d2 = parse_coord_pair("  d2 (x y): ")

        plan = compute_gate_plan(s1, s2)
        print(
            f"[PLAN] Gate={plan['gate_axis']} | Stage={tuple(round(v/TILE, 2) for v in plan['stage_pt'])} "
            f"| Entry heading={plan['entry_heading']} deg"
        )

        navigate_origin_to_entrance(plan)
        map_street(plan)
        navigate_entrance_to_origin(plan)

        map_data = save_and_print_map(plan, d1, d2)

        input("Phase 1 complete. Press ENTER once facilitator authorizes Phase 2...")
        run_phase2_placeholder(plan, d1, d2, map_data)
    else:
        raise ValueError(f"Unknown RUN_MODE: {RUN_MODE}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n[EXIT] KeyboardInterrupt received — stopping motors safely.")
    finally:
        shutdown.set()
        stop_motors()
        time.sleep(0.05)
        try:
            reset_brick()
