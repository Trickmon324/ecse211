# ==============================================================================
# 5. MATH & HARDWARE HELPERS
# ==============================================================================
def wrap180(angle_deg):
    return (angle_deg + 180.0) % 360.0 - 180.0


def clamp(val, lo, hi):
    return max(lo, min(hi, val))


def snap_cardinal(angle_deg):
    return round(angle_deg / 90.0) * 90.0 % 360.0


def heading_unit_vec(heading_deg):
    rad = math.radians(heading_deg)
    return math.sin(rad), math.cos(rad)


def right_unit_vec(heading_deg):
    ux, uy = heading_unit_vec(heading_deg)
    return uy, -ux


def coord_to_tile(px_cm, py_cm):
    return int(math.floor(px_cm / TILE)), int(math.floor(py_cm / TILE))


def normalize_wall_edge(p1, p2):
    return tuple(sorted([p1, p2]))


def read_encoder_deg(motor):
    try:
        if hasattr(motor, "get_position"):
            val = motor.get_position()
        elif hasattr(motor, "get_encoder"):
            val = motor.get_encoder()
        else:
            raise AttributeError("Motor has neither get_position nor get_encoder")
        return None if val is None else float(val)
    except Exception:
        return None


def zero_encoder(motor):
    if hasattr(motor, "reset_encoder"):
        motor.reset_encoder()


def set_drive_powers(left_pwr, right_pwr):
    left_motor.set_power(int(round(clamp(left_pwr, -100, 100))))
    right_motor.set_power(int(round(clamp(right_pwr, -100, 100))))


def stop_motors():
    if left_motor is not None:
        left_motor.set_power(0)
    if right_motor is not None:
        right_motor.set_power(0)


def is_bumper_pressed():
    try:
        if hasattr(touch_sensor, "get_value"):
            val = touch_sensor.get_value()
        elif hasattr(touch_sensor, "is_pressed"):
            val = touch_sensor.is_pressed()
        else:
            val = 0
        return val == 1 or val is True
    except Exception:
        return False


def read_light_sum(sensor):
    try:
        rgb = sensor.get_rgb()
        if rgb is not None and len(rgb) >= 3 and all(v is not None for v in rgb[:3]):
            return float(rgb[0] + rgb[1] + rgb[2])
    except Exception:
        pass
    return None


def read_raw_us_cm():
    try:
        d = side_us.get_cm()
        if d is not None and 0.0 < d < 254.0:
            return float(d)
    except Exception:
        pass
    return None


def get_pose():
    with odo_lock:
        return x_cm, y_cm, theta_deg, travel_cm


def set_pose(new_x, new_y, new_theta):
    global x_cm, y_cm, theta_deg
    with odo_lock:
        x_cm = float(new_x)
        y_cm = float(new_y)
        theta_deg = float(new_theta) % 360.0


def get_light_medians():
    with sensor_lock:
        med_l = statistics.median(left_rgb_buf) if left_rgb_buf else None
        med_r = statistics.median(right_rgb_buf) if right_rgb_buf else None
    return med_l, med_r


def is_left_on_line(med_l):
    return med_l is not None and med_l < (WHITE_LEFT - LINE_DROP)


def is_right_on_line(med_r):
    return med_r is not None and med_r < (WHITE_RIGHT - LINE_DROP)


def get_filtered_us_cm():
    with sensor_lock:
        if not us_buf:
            return None
        return statistics.median(us_buf)


def sample_fresh_side_us(num_samples=US_FILTER_SAMPLES):
    with sensor_lock:
        us_buf.clear()
    samples = []
    deadline = time.monotonic() + 0.25
    while len(samples) < num_samples and time.monotonic() < deadline:
        val = read_raw_us_cm()
        if val is not None:
            samples.append(val)
            with sensor_lock:
                us_buf.append(val)
        time.sleep(0.015)
    if not samples:
        return None
    return statistics.median(samples)


# ==============================================================================
# 6. BACKGROUND ODOMETRY & SENSOR THREAD
# ==============================================================================
def odometer_thread_loop():
    global x_cm, y_cm, theta_deg, left_distance_cm, right_distance_cm, travel_cm

    last_l = read_encoder_deg(left_motor) or 0.0
    last_r = read_encoder_deg(right_motor) or 0.0

    while not shutdown.is_set():
        t_start = time.monotonic()

        cur_l = read_encoder_deg(left_motor)
        cur_r = read_encoder_deg(right_motor)
        if cur_l is not None and cur_r is not None:
            dl = math.radians(cur_l - last_l) * WHEEL_RADIUS
            dr = math.radians(cur_r - last_r) * WHEEL_RADIUS * RIGHT_WHEEL_SCALE
            last_l = cur_l
            last_r = cur_r

            ds = (dl + dr) / 2.0
            dtheta_raw = math.degrees((dl - dr) / TRACK_WIDTH)
            factor = RIGHT_TURN_FACTOR if dtheta_raw >= 0.0 else LEFT_TURN_FACTOR
            dtheta = dtheta_raw / factor

            with odo_lock:
                theta_mid = math.radians(theta_deg + dtheta / 2.0)
                x_cm += ds * math.sin(theta_mid)
                y_cm += ds * math.cos(theta_mid)
                theta_deg = (theta_deg + dtheta) % 360.0
                left_distance_cm += dl
                right_distance_cm += dr
                travel_cm += ds

        # Read sensors OUTSIDE sensor_lock so lock is only held for deque.append
        rgb_l = read_light_sum(left_light)
        rgb_r = read_light_sum(right_light)
        with sensor_lock:
            turning_now = is_turning
            if rgb_l is not None:
                left_rgb_buf.append(rgb_l)
            if rgb_r is not None:
                right_rgb_buf.append(rgb_r)

        if not turning_now:
            us_val = read_raw_us_cm()
            if us_val is not None:
                with sensor_lock:
                    if not is_turning:
                        us_buf.append(us_val)

        elapsed = time.monotonic() - t_start
        sleep_time = LOOP_SECONDS - elapsed
        if sleep_time > 0:
            time.sleep(sleep_time)


def wait_for_initial_sensors():
    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        med_l, med_r = get_light_medians()
        if med_l is not None and med_r is not None:
            break
        time.sleep(0.02)


# ==============================================================================
# 7. PRIMITIVE MOTION & LINE SQUARING
# ==============================================================================
def turn_by_angle(delta_deg, base_power=TURN_POWER):
    """Turn relative to current heading with anti-stall boost and US turn-freeze."""
    global is_turning

    if abs(delta_deg) < TURN_TOLERANCE_DEG:
        return

    print(f"[TURN] Turning by {delta_deg:+.1f} deg...")
    with sensor_lock:
        is_turning = True

    try:
        _, _, start_theta, _ = get_pose()
        accumulated = 0.0
        prev_theta = start_theta
        t0 = time.monotonic()

        last_progress_t = t0
        last_progress_acc = 0.0
        stall_boost = 0.0

        while not shutdown.is_set():
            _, _, cur_theta, _ = get_pose()
            step = wrap180(cur_theta - prev_theta)
            accumulated += step
            prev_theta = cur_theta

            remaining = delta_deg - accumulated
            if abs(remaining) <= TURN_TOLERANCE_DEG:
                break
            if time.monotonic() - t0 > TURN_TIMEOUT_S:
                print(f"[WARN] Turn timeout (remaining={remaining:.2f} deg)")
                break

            now = time.monotonic()
            if abs(accumulated - last_progress_acc) > 0.4:
                last_progress_acc = accumulated
                last_progress_t = now
                stall_boost = 0.0
            elif now - last_progress_t >= STALL_CHECK_SEC:
                stall_boost = min(stall_boost + STALL_BOOST_STEP, MAX_BOOST_POWER - TURN_MIN_POWER)
                last_progress_t = now

            done = abs(accumulated)
            rem = abs(remaining)
            ramp_up = clamp(done / TURN_RAMP_DEG, 0.0, 1.0)
            ramp_down = clamp(rem / TURN_SLOW_DEG, 0.0, 1.0)
            scale = min(ramp_up, ramp_down)
            pwr = clamp(TURN_MIN_POWER + scale * (base_power - TURN_MIN_POWER) + stall_boost, 0, MAX_BOOST_POWER)

            if remaining > 0:
                set_drive_powers(pwr, -pwr)
            else:
                set_drive_powers(-pwr, pwr)

            time.sleep(LOOP_SECONDS)

        stop_motors()
        time.sleep(0.08)
    finally:
        with sensor_lock:
            us_buf.clear()
            is_turning = False


def turn_to_heading(target_heading_deg, base_power=TURN_POWER):
    _, _, cur_theta, _ = get_pose()
    delta = wrap180(target_heading_deg - cur_theta)
    turn_by_angle(delta, base_power=base_power)


def back_up(dist_cm, heading_hold_deg=None, power=CREEP_POWER):
    if dist_cm <= 0:
        return
    print(f"[MOVE] Backing up {dist_cm:.1f} cm...")
    _, _, cur_theta, start_travel = get_pose()
    target_h = cur_theta if heading_hold_deg is None else heading_hold_deg

    t0 = time.monotonic()
    last_prog_t = t0
    last_backed = 0.0
    boost = 0.0

    while not shutdown.is_set():
        _, _, theta_now, trav = get_pose()
        backed = start_travel - trav
        if backed >= dist_cm or (time.monotonic() - t0) > 4.0:
            break

        now = time.monotonic()
        if backed - last_backed > 0.25:
            last_backed = backed
            last_prog_t = now
            boost = 0.0
        elif now - last_prog_t >= STALL_CHECK_SEC:
            boost = min(boost + STALL_BOOST_STEP, MAX_BOOST_POWER - power)
            last_prog_t = now

        err = wrap180(target_h - theta_now)
        corr = HEADING_KP * err
        p = power + boost
        set_drive_powers(-p + corr, -p - corr)
        time.sleep(LOOP_SECONDS)

    stop_motors()
    time.sleep(0.05)


def creep_forward(dist_cm, target_heading_deg, power=CREEP_POWER, stop_on_bump=False):
    if dist_cm <= 0:
        return False
    _, _, _, start_travel = get_pose()
    t0 = time.monotonic()
    while not shutdown.is_set():
        if stop_on_bump and is_bumper_pressed():
            stop_motors()
            return True
        _, _, cur_theta, trav = get_pose()
        if (trav - start_travel) >= dist_cm or (time.monotonic() - t0) > 5.0:
            break
        err = wrap180(target_heading_deg - cur_theta)
        corr = HEADING_KP * err
        set_drive_powers(power + corr, power - corr)
        time.sleep(LOOP_SECONDS)

    stop_motors()
    time.sleep(0.04)
    return False


def square_on_line(cardinal_heading, leg_length_cm, avg_leg_heading_deg, verbose=True):
    """One-motor-stop squaring with anti-stall boost and safety timeout."""
    _, _, theta_start, _ = get_pose()
    med_l, med_r = get_light_medians()
    left_hit = is_left_on_line(med_l)
    right_hit = is_right_on_line(med_r)

    if not left_hit and not right_hit:
        return False, None

    t0 = time.monotonic()
    last_prog_t = t0
    last_theta = theta_start
    boost = 0.0
    bumped = False

    while not (left_hit and right_hit) and not shutdown.is_set():
        if is_bumper_pressed():
            bumped = True
            break
        now = time.monotonic()
        if now - t0 > ALIGN_TIMEOUT_S:
            break
        _, _, cur_theta, _ = get_pose()
        if abs(wrap180(cur_theta - theta_start)) > ALIGN_MAX_PIVOT_DEG:
            break

        if abs(wrap180(cur_theta - last_theta)) > 0.3:
            last_theta = cur_theta
            last_prog_t = now
            boost = 0.0
        elif now - last_prog_t >= STALL_CHECK_SEC:
            boost = min(boost + STALL_BOOST_STEP, MAX_BOOST_POWER - ALIGN_POWER)
            last_prog_t = now

        med_l, med_r = get_light_medians()
        if not left_hit and is_left_on_line(med_l):
            left_hit = True
        if not right_hit and is_right_on_line(med_r):
            right_hit = True

        if left_hit and right_hit:
            break

        pwr = ALIGN_POWER + boost
        pwr_l = 0 if left_hit else pwr
        pwr_r = 0 if right_hit else pwr
        set_drive_powers(pwr_l, pwr_r)
        time.sleep(LOOP_SECONDS)

    stop_motors()
    time.sleep(0.05)

    if bumped or not (left_hit and right_hit):
        if verbose:
            print("[ALIGN] Skipped snap (timeout/bump/max pivot).")
        return False, None

    cur_x, cur_y, theta_end, _ = get_pose()
    ux, uy = heading_unit_vec(cardinal_heading)

    if abs(ux) > abs(uy):
        sensor_axis = cur_x + ux * SENSOR_OFFSET
        line_coord = round(sensor_axis / TILE) * TILE
    else:
        sensor_axis = cur_y + uy * SENSOR_OFFSET
        line_coord = round(sensor_axis / TILE) * TILE

    if abs(sensor_axis - line_coord) > PERP_LINE_TOLERANCE_CM:
        if verbose:
            print(f"[ALIGN] Rejected outlier snap: sensor={sensor_axis:.2f} vs grid={line_coord:.2f}")
        return False, None

    delta_theta_pivot = wrap180(theta_end - theta_start)
    phi_approach_deg = -delta_theta_pivot * (1.0 + ALIGN_LEVER_RATIO)
    odo_heading_bias_deg = wrap180(avg_leg_heading_deg - cardinal_heading)
    unmeasured_phi_deg = phi_approach_deg - odo_heading_bias_deg

    drift_lat = 0.0
    if APPLY_LATERAL_DRIFT and leg_length_cm > 0:
        raw_drift = leg_length_cm * math.sin(math.radians(unmeasured_phi_deg))
        drift_lat = clamp(raw_drift, -MAX_LATERAL_DRIFT_CM, MAX_LATERAL_DRIFT_CM)

    rx, ry = right_unit_vec(cardinal_heading)
    if abs(ux) > abs(uy):
        new_x = line_coord - ux * SENSOR_OFFSET
        new_y = cur_y + drift_lat * ry
    else:
        new_x = cur_x + drift_lat * rx
        new_y = line_coord - uy * SENSOR_OFFSET

    set_pose(new_x, new_y, cardinal_heading)

    if verbose:
        print(
            f"[ALIGN] line={line_coord:.1f}cm pivot={delta_theta_pivot:+.2f}deg "
            f"drift={drift_lat:+.2f}cm -> pose=({new_x:.1f}, {new_y:.1f}, {cardinal_heading:.0f})"
        )

    return True, line_coord


# ==============================================================================
# 8. OPEN-SPACE POINT-TO-POINT NAVIGATION (NO SIDE-WALL BIAS)
# ==============================================================================
def drive_to_point_cardinal(target_x_cm, target_y_cm, cardinal_heading,
                            use_line_squaring=True, initial_blind_cm=4.0,
                            power=APPROACH_POWER):
    """
    Drive straight along cardinal_heading to (target_x_cm, target_y_cm) with
    anti-stall boost, line squaring, safety timeout, and live status telemetry.
    Returns (reached_ok, bumped).
    """
    turn_to_heading(cardinal_heading)
    ux, uy = heading_unit_vec(cardinal_heading)

    cur_x, cur_y, cur_theta, start_trav = get_pose()
    init_dist = max(0.0, (target_x_cm - cur_x) * ux + (target_y_cm - cur_y) * uy)
    print(f"[NAV] Driving hdg={cardinal_heading:.0f} deg dist={init_dist:.1f} cm -> ({target_x_cm:.1f}, {target_y_cm:.1f})")

    last_line_trav = start_trav
    blind_cm = initial_blind_cm
    heading_sum = 0.0
    heading_cnt = 0

    t0 = time.monotonic()
    max_time_s = max(8.0, (init_dist / 5.0) + 6.0)
    last_prog_t = t0
    last_trav = start_trav
    boost = 0.0
    last_dbg = t0

    while not shutdown.is_set():
        if is_bumper_pressed():
            stop_motors()
            return False, True

        cur_x, cur_y, cur_theta, cur_trav = get_pose()
        rem_cm = (target_x_cm - cur_x) * ux + (target_y_cm - cur_y) * uy
        if rem_cm <= 0.5:
            break

        now = time.monotonic()
        if now - t0 > max_time_s:
            print(f"[WARN] drive_to_point timeout (rem={rem_cm:.1f} cm)")
            break

        # Anti-stall watchdog
        if abs(cur_trav - last_trav) > 0.25:
            last_trav = cur_trav
            last_prog_t = now
            boost = 0.0
        elif now - last_prog_t >= STALL_CHECK_SEC:
            boost = min(boost + STALL_BOOST_STEP, MAX_BOOST_POWER - CREEP_POWER)
            last_prog_t = now

        heading_sum += wrap180(cur_theta - cardinal_heading)
        heading_cnt += 1

        dist_since_line = cur_trav - last_line_trav
        if use_line_squaring and dist_since_line >= blind_cm and rem_cm > 1.0:
            sensor_pos = (cur_x + ux * SENSOR_OFFSET) if abs(ux) > abs(uy) else (cur_y + uy * SENSOR_OFFSET)
            nearest_line = round(sensor_pos / TILE) * TILE
            if abs(sensor_pos - nearest_line) <= PERP_LINE_TOLERANCE_CM:
                med_l, med_r = get_light_medians()
                if is_left_on_line(med_l) or is_right_on_line(med_r):
                    avg_h = cardinal_heading + (heading_sum / max(1, heading_cnt))
                    ok, _ = square_on_line(cardinal_heading, dist_since_line, avg_h)
                    _, _, _, post_trav = get_pose()
                    last_line_trav = post_trav
                    # CRITICAL FIX: Always advance blind window even if snap timed out,
                    # so we never re-trigger endlessly on the same black line!
                    blind_cm = BLIND_AFTER_LINE_CM if ok else 7.0
                    heading_sum = 0.0
                    heading_cnt = 0
                    last_trav = post_trav
                    last_prog_t = time.monotonic()
                    boost = 0.0
                    continue

        err = wrap180(cardinal_heading - cur_theta)
        corr = HEADING_KP * err
        base_p = CREEP_POWER if rem_cm < 6.0 else power
        drive_pwr = clamp(base_p + boost, 0, MAX_BOOST_POWER)
        set_drive_powers(drive_pwr + corr, drive_pwr - corr)

        if now - last_dbg >= 1.0:
            print(f"[DBG] pos=({cur_x:.1f},{cur_y:.1f}) th={cur_theta:.1f} rem={rem_cm:.1f} pwr={drive_pwr:.0f}")
            last_dbg = now

        time.sleep(LOOP_SECONDS)

    stop_motors()
    time.sleep(0.05)
    return True, False


# ==============================================================================
# 9. ENTRANCE GEOMETRY & BUMPER-SAFE APPROACH / RETURN PATH PLANNER
# ==============================================================================
def parse_coord_pair(prompt_text):
    while True:
        raw = input(prompt_text).strip().replace("(", "").replace(")", "").replace(",", " ")
        parts = raw.split()
        if len(parts) == 2:
            try:
                gx, gy = int(parts[0]), int(parts[1])
                if MAP_X_MIN <= gx <= MAP_X_MAX and MAP_Y_MIN <= gy <= MAP_Y_MAX:
                    return (gx, gy)
                print(f"Coordinates out of arena bounds [{MAP_X_MIN},{MAP_X_MAX}] x [{MAP_Y_MIN},{MAP_Y_MAX}].")
                continue
            except ValueError:
                pass
        print("Invalid input. Enter two integers like: 1 3")


def compute_gate_plan(s1, s2):
    x1, y1 = s1
    x2, y2 = s2

    if x1 == x2 and abs(y1 - y2) == 1:
        gate_axis = "vertical"
        x_gate = float(x1)
        my = (y1 + y2) / 2.0

        if x_gate >= 1.0:
            entry_heading = 90.0
            x_stage = 0.0
            entry_ux, entry_uy = 1.0, 0.0
        elif x_gate == 0.0:
            entry_heading = 90.0
            x_stage = -0.5
            entry_ux, entry_uy = 1.0, 0.0
        else:
            entry_heading = 270.0
            x_stage = 0.0
            entry_ux, entry_uy = -1.0, 0.0

        waypoints = []
        if abs(x_stage - 0.0) > 1e-6:
            waypoints.append((x_stage * TILE, 0.0, 270.0 if x_stage < 0 else 90.0))
        y_dir = 0.0 if my >= 0.0 else 180.0
        waypoints.append((x_stage * TILE, my * TILE, y_dir))
        stage_pt = (x_stage * TILE, my * TILE)

        gate_line_cm = x_gate * TILE
        gate_center_perp_cm = my * TILE
        first_tile_center = ((x_gate + 0.5 * entry_ux) * TILE, my * TILE)
        first_tile = coord_to_tile(*first_tile_center)

    elif y1 == y2 and abs(x1 - x2) == 1:
        gate_axis = "horizontal"
        y_gate = float(y1)
        mx = (x1 + x2) / 2.0

        if y_gate >= 1.0:
            entry_heading = 0.0
            y_stage = 0.0
            entry_ux, entry_uy = 0.0, 1.0
        elif y_gate == 0.0:
            entry_heading = 0.0
            y_stage = -0.5
            entry_ux, entry_uy = 0.0, 1.0
        else:
            entry_heading = 180.0
            y_stage = 0.0
            entry_ux, entry_uy = 0.0, -1.0

        waypoints = []
        if abs(y_stage - 0.0) > 1e-6:
            waypoints.append((0.0, y_stage * TILE, 180.0 if y_stage < 0 else 0.0))
        x_dir = 90.0 if mx >= 0.0 else 270.0
        waypoints.append((mx * TILE, y_stage * TILE, x_dir))
        stage_pt = (mx * TILE, y_stage * TILE)

        gate_line_cm = y_gate * TILE
        gate_center_perp_cm = mx * TILE
        first_tile_center = (mx * TILE, (y_gate + 0.5 * entry_uy) * TILE)
        first_tile = coord_to_tile(*first_tile_center)
    else:
        raise ValueError(f"Invalid street entrance s1={s1}, s2={s2}: must be 1 grid unit apart.")

    return {
        "gate_axis": gate_axis,
        "s1": s1,
        "s2": s2,
        "waypoints_to_stage": waypoints,
        "stage_pt": stage_pt,
        "entry_heading": entry_heading,
        "exit_heading": (entry_heading + 180.0) % 360.0,
        "entry_vec": (entry_ux, entry_uy),
        "gate_line_cm": gate_line_cm,
        "gate_center_perp_cm": gate_center_perp_cm,
        "first_tile_center": first_tile_center,
        "first_tile": first_tile,
    }


def navigate_origin_to_entrance(plan):
    print("[NAV] Moving from (0, 0) to street entrance safely...")
    for wx, wy, hdg in plan["waypoints_to_stage"]:
        cur_x, cur_y, _, _ = get_pose()
        if math.hypot(wx - cur_x, wy - cur_y) < 1.0:
            continue
        ok, bumped = drive_to_point_cardinal(wx, wy, hdg, use_line_squaring=True, initial_blind_cm=4.0)
        if bumped:
            print("[WARN] Unexpected bump during open-space approach; backing up.")
            back_up(BUMP_BACKUP_CM, hdg)

    ftx, fty = plan["first_tile_center"]
    ok, bumped = drive_to_point_cardinal(
        ftx, fty, plan["entry_heading"], use_line_squaring=True, initial_blind_cm=4.0
    )
    if bumped:
        print("[WARN] Bumper triggered entering gate; backing up slightly.")
        back_up(BUMP_BACKUP_CM, plan["entry_heading"])
    print(f"[NAV] Centered inside street entry tile {plan['first_tile']}.")


def navigate_entrance_to_origin(plan):
    print("[NAV] Returning from street exit to (0, 0)...")
    sx, sy = plan["stage_pt"]
    exit_h = plan["exit_heading"]

    drive_to_point_cardinal(sx, sy, exit_h, use_line_squaring=True, initial_blind_cm=BLIND_AFTER_LINE_CM)

    rev_points = [(0.0, 0.0)]
    if len(plan["waypoints_to_stage"]) > 1:
        ox, oy, _ = plan["waypoints_to_stage"][0]
        rev_points = [(ox, oy), (0.0, 0.0)]

    for px, py in rev_points:
        cur_x, cur_y, _, _ = get_pose()
        dx, dy = px - cur_x, py - cur_y
        if math.hypot(dx, dy) < 1.0:
            continue
        if abs(dx) >= abs(dy):
            hdg = 90.0 if dx > 0 else 270.0
        else:
            hdg = 0.0 if dy > 0 else 180.0
        drive_to_point_cardinal(px, py, hdg, use_line_squaring=True, initial_blind_cm=4.0)

    turn_to_heading(START_HEADING_DEG)
    print("[NAV] Returned cleanly to origin (0, 0).")


